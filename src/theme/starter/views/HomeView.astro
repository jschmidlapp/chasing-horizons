---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Img from '../components/Img.astro';
import RegionCard from '../components/RegionCard.astro';
import EntryCard from '../components/EntryCard.astro';
import { url } from '@lib/content';
import type { HomeViewProps } from '../../types';

type Props = HomeViewProps;
const { page, regions, featuredTrips, featuredSpots, regionTitles, more } = Astro.props;
const { title, tagline, hero } = page.data;
---

<BaseLayout image={hero}>
  <Hero image={hero} title={title} subtitle={tagline} size="tall" />

  <section class="section wrap">
    <div class="section-head">
      <h2 class="section-title">Regions</h2>
      <a href={url('/places/')}>All regions →</a>
    </div>
    <div class="card-grid regions">
      {regions.map((r) => <RegionCard {...r} />)}
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2 class="section-title">Trips</h2>
      <a href={url('/trips/')}>All trips →</a>
    </div>
    <div class="card-grid">
      {featuredTrips.map((t) => <EntryCard entry={t} eyebrow={regionTitles[t.data.region.id]} />)}
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2 class="section-title">Places</h2>
      <a href={url('/spots/')}>All places →</a>
    </div>
    <div class="card-grid">
      {featuredSpots.map((s) => <EntryCard entry={s} eyebrow={regionTitles[s.data.region.id]} />)}
    </div>
  </section>

  {more.length > 0 && (
    <section class="section wrap">
      <h2 class="section-title">More</h2>
      <div class="card-grid">
        {more.map(({ href, title, text, image }) => (
          <a class="card" href={href}>
            <div class="card-media">
              {image && <Img src={image} alt="" sizes="(min-width: 1180px) 380px, (min-width: 600px) 45vw, 100vw" />}
            </div>
            <div class="card-body">
              <h3 class="card-title">{title}</h3>
              {text && <p class="card-text">{text}</p>}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .section-head a { font-weight: 500; text-decoration: none; white-space: nowrap; }

  /* Phones: each section becomes a sideways-swiping row, so the page reads as a short list of
     sections instead of one long column of cards. The peek of the next card hints that it scrolls. */
  @media (max-width: 599px) {
    .section { padding-block: 24px; }
    .card-grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 80%;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      /* Bleed to the screen edges while the first card still lines up with the heading. */
      margin-inline: calc(-1 * var(--gutter));
      padding: 4px var(--gutter) 14px;
      scroll-padding-inline: var(--gutter);
    }
    .card-grid::-webkit-scrollbar { display: none; }
    .card-grid > :global(*) { scroll-snap-align: start; }
    /* Regions only carry a name and counts, so they can be smaller. */
    .card-grid.regions { grid-auto-columns: 58%; }
  }
</style>
