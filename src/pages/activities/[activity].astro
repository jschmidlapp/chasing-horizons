---
import TripListView from '@theme/views/TripListView.astro';
import { ACTIVITY_LABELS, getRegions, getTrips, regionTitles, type Activity } from '@lib/content';
import { ACTIVITIES } from '../../content.config';

export async function getStaticPaths() {
  const trips = await getTrips();
  return ACTIVITIES.filter((a) => trips.some((t) => t.data.activities.includes(a)))
    .map((activity) => ({ params: { activity } }));
}

const activity = Astro.params.activity as Activity;
const [regions, all] = await Promise.all([getRegions(), getTrips()]);
const trips = all.filter((t) => t.data.activities.includes(activity));
---

<TripListView
  title={ACTIVITY_LABELS[activity]}
  subtitle={`${trips.length} trips`}
  image={trips.find((t) => t.data.banner)?.data.banner ?? trips[0]?.data.cover}
  trips={trips}
  regionTitles={regionTitles(regions)}
/>
