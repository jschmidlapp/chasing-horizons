---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RegionCard from '../components/RegionCard.astro';
import TripCard from '../components/TripCard.astro';
import { regionUrl, url } from '@lib/content';
import type { RegionViewProps } from '../../types';

type Props = RegionViewProps;
const { region, ancestors, subRegions, tripGroups, description, regionTitles } = Astro.props;
const { title, banner, cover } = region.data;
const crumbs = [{ href: url('/places/'), label: 'Places' }, ...ancestors.map((r) => ({ href: regionUrl(r), label: r.data.title }))];
---

<BaseLayout title={title} description={description} image={cover ?? banner}>
  <Hero image={banner ?? cover} title={title}>
    <Breadcrumbs slot="eyebrow" items={crumbs} />
  </Hero>
  <div class="wrap">
    <div class="intro prose"><slot /></div>

    {subRegions.length > 0 && (
      <section class="section">
        <h2 class="section-title">Areas</h2>
        <div class="card-grid">{subRegions.map(({ region, count }) => <RegionCard region={region} count={count} />)}</div>
      </section>
    )}

    {tripGroups.map((g) => (
      <section class="section">
        {(g.heading || tripGroups.length > 1 || subRegions.length > 0) && <h2 class="section-title">{g.heading ?? 'Other trips'}</h2>}
        <div class="card-grid">
          {g.trips.map((t) => <TripCard trip={t} eyebrow={t.data.region.id !== region.id ? regionTitles[t.data.region.id] : undefined} />)}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .intro:not(:empty) { padding-top: 40px; }
</style>
