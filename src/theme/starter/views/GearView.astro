---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Img from '../components/Img.astro';
import type { GearViewProps } from '../../types';

type Props = GearViewProps;
const { page, items } = Astro.props;
---

<BaseLayout title={page.data.title} description={page.data.tagline} image={page.data.hero}>
  <Hero image={page.data.hero} title={page.data.title} subtitle={page.data.tagline} />
  <section class="section wrap">
    <div class="card-grid">
      {items.map((g) => (
        <div class="card">
          <div class="card-media">{g.data.image && <Img src={g.data.image} alt={g.data.title} sizes="(min-width: 1180px) 380px, (min-width: 600px) 45vw, 100vw" />}</div>
          <div class="card-body">
            <h3 class="card-title">{g.data.title}</h3>
            {g.data.description && <p class="card-text">{g.data.description}</p>}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .card:hover { transform: none; }
  .card-media { aspect-ratio: 4 / 3; }
</style>
