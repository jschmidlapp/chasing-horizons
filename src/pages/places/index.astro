---
import PlacesView from '@theme/views/PlacesView.astro';
import { getPage, getRegions, getTrips, topLevelRegions, withCounts } from '@lib/content';

const [page, regions, trips] = await Promise.all([getPage('places'), getRegions(), getTrips()]);
---

<PlacesView page={page} regions={withCounts(topLevelRegions(regions), regions, trips)} />
