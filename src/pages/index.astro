---
import HomeView from '@theme/views/HomeView.astro';
import { getPage, getRegions, getSpots, getTrips, regionTitles, topLevelRegions, withCounts, type Entry } from '@lib/content';

const [page, regions, trips, spots] = await Promise.all([getPage('home'), getRegions(), getTrips(), getSpots()]);

// Until entries have dates, feature the richest write-ups (longest bodies); afterwards, the newest.
const richest = <T extends Entry>(list: T[]) => [...list].sort((a, b) => (b.body?.length ?? 0) - (a.body?.length ?? 0));
const featuredTrips = (trips.some((t) => t.data.date) ? trips : richest(trips)).slice(0, 6);
const featuredSpots = (spots.some((s) => s.data.lastVisited) ? spots : richest(spots)).slice(0, 6);
---

<HomeView
  page={page}
  regions={withCounts(topLevelRegions(regions), regions, trips, spots)}
  featuredTrips={featuredTrips}
  featuredSpots={featuredSpots}
  regionTitles={regionTitles(regions)}
/>
