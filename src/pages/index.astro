---
import HomeView from '@theme/views/HomeView.astro';
import { getPage, getRegions, getSpots, getTrips, regionTitles, topLevelRegions, url, withCounts, type Entry } from '@lib/content';

const [page, regions, trips, spots, gear, snacks] = await Promise.all([
  getPage('home'), getRegions(), getTrips(), getSpots(), getPage('gear'), getPage('snacks'),
]);

// `featured: true` entries come first (in list order). Remaining slots: until entries have dates, the
// richest write-ups (longest bodies); afterwards, the newest.
const richest = <T extends Entry>(list: T[]) => [...list].sort((a, b) => (b.body?.length ?? 0) - (a.body?.length ?? 0));
const pickFeatured = <T extends Entry>(list: T[], dated: boolean) => {
  const rest = dated ? list : richest(list);
  return [...list.filter((e) => e.data.featured), ...rest.filter((e) => !e.data.featured)].slice(0, 6);
};
const featuredTrips = pickFeatured(trips, trips.some((t) => t.data.date));
const featuredSpots = pickFeatured(spots, spots.some((s) => s.data.lastVisited));
---

<HomeView
  page={page}
  regions={withCounts(topLevelRegions(regions), regions, trips, spots)}
  featuredTrips={featuredTrips}
  featuredSpots={featuredSpots}
  regionTitles={regionTitles(regions)}
  more={[gear, snacks].map((p) => ({
    href: url(`/${p.id}/`),
    title: p.data.title,
    text: p.data.tagline,
    image: p.data.hero ?? p.data.photos[0]?.image,
  }))}
/>
