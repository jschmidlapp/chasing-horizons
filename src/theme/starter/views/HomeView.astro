---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Img from '../components/Img.astro';
import RegionCard from '../components/RegionCard.astro';
import TripCard from '../components/TripCard.astro';
import { ACTIVITY_LABELS, activityUrl, url, type Activity } from '@lib/content';
import type { HomeViewProps } from '../../types';

type Props = HomeViewProps;
const { page, regions, featuredTrips, activityCounts, regionTitles } = Astro.props;
const { title, tagline, hero, placesCard, gearCard } = page.data;
---

<BaseLayout image={hero}>
  <Hero image={hero} title={title} subtitle={tagline} size="tall" />

  <section class="section wrap">
    <h2 class="section-title">Places</h2>
    <div class="card-grid">
      {regions.map(({ region, count }) => <RegionCard region={region} count={count} />)}
    </div>
  </section>

  <section class="section wrap">
    <h2 class="section-title">Trips</h2>
    <div class="card-grid">
      {featuredTrips.map((t) => <TripCard trip={t} eyebrow={regionTitles[t.data.region.id]} />)}
    </div>
  </section>

  <section class="section wrap tiles">
    {(Object.entries(activityCounts) as [Activity, number][]).filter(([, n]) => n > 0).map(([a, n]) => (
      <a class="tile" href={activityUrl(a)}><strong>{ACTIVITY_LABELS[a]}</strong><span>{n} trips</span></a>
    ))}
    <a class="tile photo" href={url('/places/')}>
      {placesCard && <Img src={placesCard} alt="" sizes="(min-width: 900px) 33vw, 100vw" />}
      <strong>All places</strong>
    </a>
    <a class="tile photo" href={url('/gear/')}>
      {gearCard && <Img src={gearCard} alt="" sizes="(min-width: 900px) 33vw, 100vw" />}
      <strong>Gear I use</strong>
    </a>
  </section>
</BaseLayout>

<style>
  .tiles { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 140px;
    padding: 18px;
    border-radius: var(--radius);
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    overflow: hidden;
  }
  .tile:hover { color: #fff; filter: brightness(1.08); }
  .tile strong { position: relative; font-family: var(--font-display); font-size: 1.35rem; }
  .tile span { position: relative; opacity: 0.85; font-size: 0.9rem; }
  .tile.photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .tile.photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgb(0 0 0 / 0.6), transparent 60%); }
  .tile.photo strong { z-index: 1; }
</style>
