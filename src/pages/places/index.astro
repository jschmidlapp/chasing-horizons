---
import PlacesView from '@theme/views/PlacesView.astro';
import { getPage, getRegions, getSpots, getTrips, topLevelRegions, withCounts } from '@lib/content';

const [page, regions, trips, spots] = await Promise.all([getPage('places'), getRegions(), getTrips(), getSpots()]);
---

<PlacesView page={page} regions={withCounts(topLevelRegions(regions), regions, trips, spots)} />
