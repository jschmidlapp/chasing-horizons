---
import { render } from 'astro:content';
import TripView from '@theme/views/TripView.astro';
import { excerpt, getRegions, getTrips, regionAncestors, type Trip } from '@lib/content';
import { loadTrack } from '@lib/gpx';

export async function getStaticPaths() {
  const trips = await getTrips();
  return trips.map((trip) => ({ params: { slug: trip.id }, props: { trip } }));
}

const { trip } = Astro.props as { trip: Trip };
const [regions, trips] = await Promise.all([getRegions(), getTrips()]);
const region = regions.find((r) => r.id === trip.data.region.id)!;
const regionChain = [...regionAncestors(regions, region), region];

// Up to 3 neighbours in the same region, continuing in order after this trip.
const siblings = trips.filter((t) => t.data.region.id === region.id);
const i = siblings.findIndex((t) => t.id === trip.id);
const related = [...siblings.slice(i + 1), ...siblings.slice(0, i)].slice(0, 3);

const { Content } = await render(trip);
---

<TripView trip={trip} regionChain={regionChain} track={loadTrack(trip)} related={related} description={excerpt(trip)}>
  <Content />
</TripView>
