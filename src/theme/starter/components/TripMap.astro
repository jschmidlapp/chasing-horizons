---
// Route map from a trip's GPX track (computed at build time in @lib/gpx). Leaflet + OpenTopoMap tiles.
import type { Track } from '@lib/gpx';

interface Props {
  track: Track;
}
const { track } = Astro.props;
---

<figure class="trip-map">
  <div class="map" data-track={JSON.stringify(track.lines)}></div>
</figure>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  for (const el of document.querySelectorAll<HTMLElement>('.trip-map .map')) {
    const lines = JSON.parse(el.dataset.track ?? '[]') as [number, number][][];
    const map = L.map(el, { scrollWheelZoom: false });
    L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
      maxZoom: 17,
      attribution: 'Map data © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, SRTM | Style © <a href="https://opentopomap.org">OpenTopoMap</a> (CC-BY-SA)',
    }).addTo(map);
    const route = L.polyline(lines, { color: '#d9480f', weight: 4, opacity: 0.9 }).addTo(map);
    map.fitBounds(route.getBounds(), { padding: [20, 20] });
  }
</script>

<style>
  .trip-map { max-width: var(--prose); margin: 0 auto 32px; }
  .map { height: clamp(280px, 50vw, 440px); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
</style>
