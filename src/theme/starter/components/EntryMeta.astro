---
// Facts strip under a trip/spot hero: activities, date, stats, external links.
import { ACTIVITY_LABELS, formatDate, formatDateRange, isTrip, listUrl, type Entry } from '@lib/content';
import type { Track } from '@lib/gpx';

interface Props {
  entry: Entry;
  track?: Track;
}
const { entry, track } = Astro.props;
const { activities, stats, links } = entry.data;
// Frontmatter stats win; fall back to values computed from the GPX track.
const distance = stats?.distanceMiles ?? track?.distanceMiles;
const gain = stats?.elevationGainFeet ?? track?.elevationGainFeet;
const when = isTrip(entry)
  ? entry.data.date && { label: 'Date', value: formatDateRange(entry.data.date, entry.data.endDate) }
  : entry.data.lastVisited && { label: 'Last visited', value: formatDate(entry.data.lastVisited) };
const facts = [
  when,
  distance && { label: 'Distance', value: `${distance} mi` },
  gain && { label: 'Elevation gain', value: `${gain.toLocaleString('en-US')} ft` },
  stats?.duration && { label: 'Time', value: stats.duration },
  stats?.difficulty && { label: 'Difficulty', value: stats.difficulty[0].toUpperCase() + stats.difficulty.slice(1) },
].filter(Boolean) as { label: string; value: string }[];
---

<div class="entry-meta">
  <ul class="chips">
    {activities.map((a) => <li><a class="chip" href={listUrl(entry.collection, a)}>{ACTIVITY_LABELS[a]}</a></li>)}
  </ul>
  {facts.length > 0 && (
    <dl class="facts">
      {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
    </dl>
  )}
  {links.length > 0 && (
    <ul class="links">
      {links.map((l) => <li><a href={l.url} rel="noopener" target="_blank">{l.label} ↗</a></li>)}
    </ul>
  )}
</div>

<style>
  .entry-meta { max-width: var(--prose); margin: 0 0 28px; display: grid; gap: 16px; }
  .facts { display: flex; flex-wrap: wrap; gap: 12px 32px; margin: 0; padding: 16px 0; border-block: 1px solid var(--line); }
  dt { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  dd { margin: 2px 0 0; font-weight: 600; font-size: 1.05rem; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 0; padding: 0; list-style: none; }
</style>
