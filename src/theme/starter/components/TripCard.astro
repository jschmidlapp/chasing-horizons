---
import Img from './Img.astro';
import { ACTIVITY_LABELS, excerpt, formatDate, tripUrl, type Trip } from '@lib/content';

interface Props {
  trip: Trip;
  /** Shown above the title, e.g. the region name. */
  eyebrow?: string;
}
const { trip, eyebrow } = Astro.props;
const { title, cover, activities, date, area } = trip.data;
const text = excerpt(trip, 110);
const label = eyebrow ?? area;
---

<a class="card" href={tripUrl(trip)}>
  <div class="card-media">
    {cover && <Img src={cover} alt="" sizes="(min-width: 1180px) 380px, (min-width: 600px) 45vw, 100vw" />}
  </div>
  <div class="card-body">
    {label && <span class="card-eyebrow">{label}</span>}
    <h3 class="card-title">{title}</h3>
    {text && <p class="card-text">{text}</p>}
    <ul class="chips">
      {activities.map((a) => <li class="chip">{ACTIVITY_LABELS[a]}</li>)}
      {date && <li class="chip">{formatDate(date)}</li>}
    </ul>
  </div>
</a>
