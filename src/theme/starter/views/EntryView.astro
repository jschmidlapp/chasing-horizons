---
// Page for a single trip or spot.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EntryMeta from '../components/EntryMeta.astro';
import TripMap from '../components/TripMap.astro';
import EntryCard from '../components/EntryCard.astro';
import { isTrip, regionUrl, url } from '@lib/content';
import type { EntryViewProps } from '../../types';

type Props = EntryViewProps;
const { entry, regionChain, track, routeMap, linked, related, description, toc } = Astro.props;
const { title, banner, cover, area } = entry.data;
const crumbs = [
  { href: url('/places/'), label: 'Regions' },
  ...regionChain.map((r) => ({ href: regionUrl(r), label: r.data.title })),
];
const kind = isTrip(entry) ? 'trips' : 'places';
---

<BaseLayout title={title} description={description} image={cover ?? banner}>
  <Hero image={banner ?? cover} title={title} subtitle={area}>
    <Breadcrumbs slot="eyebrow" items={crumbs} />
  </Hero>

  <article class="wrap section">
    <div class="column">
      <EntryMeta entry={entry} track={track} />
      {(routeMap || track) && <TripMap track={track} routeMap={routeMap} />}
      {toc.length > 0 && (
        <nav class="toc" aria-label="On this page">
          <h2 class="toc-title">{isTrip(entry) ? 'Sections' : 'Trails'}</h2>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="prose"><slot /></div>
    </div>
  </article>

  {linked.length > 0 && (
    <section class="wrap section">
      <h2 class="section-title">{isTrip(entry) ? 'Places on this trip' : 'Trips that came here'}</h2>
      <div class="card-grid">{linked.map((e) => <EntryCard entry={e} />)}</div>
    </section>
  )}

  {related.length > 0 && (
    <section class="wrap section">
      <h2 class="section-title">More {kind} in {regionChain.at(-1)?.data.title}</h2>
      <div class="card-grid">{related.map((e) => <EntryCard entry={e} />)}</div>
    </section>
  )}
</BaseLayout>

<style>
  /* One left edge for everything: text-like blocks at --prose, maps and photos at the full column. */
  .column { max-width: var(--column); margin-inline: auto; }
  .toc { max-width: var(--prose); margin: 0 0 32px; padding: 16px 20px; background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); }
  .toc-title { font-size: 0.8rem; font-family: var(--font-sans); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 0 0 10px; }
  .toc ol { margin: 0; padding: 0; list-style: none; columns: 2 220px; column-gap: 24px; }
  .toc li { break-inside: avoid; padding: 3px 0; }
  .toc a { text-decoration: none; font-weight: 500; }
  .toc a:hover { text-decoration: underline; }
  /* Keep headings clear of the sticky header when jumping to them. */
  :global(.prose h2) { scroll-margin-top: 80px; }
</style>
