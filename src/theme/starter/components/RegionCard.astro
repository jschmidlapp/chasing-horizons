---
import Img from './Img.astro';
import { regionUrl } from '@lib/content';
import type { RegionWithCount } from '../../types';

type Props = RegionWithCount;
const { region, trips, spots } = Astro.props;
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const counts = [trips && plural(trips, 'trip'), spots && plural(spots, 'place')].filter(Boolean).join(' · ');
---

<a class="card region-card" href={regionUrl(region)}>
  <div class="card-media">
    {region.data.cover && <Img src={region.data.cover} alt="" sizes="(min-width: 1180px) 380px, (min-width: 600px) 45vw, 100vw" />}
  </div>
  <div class="card-body">
    <h3 class="card-title">{region.data.title}</h3>
    {counts && <p class="card-text">{counts}</p>}
  </div>
</a>
