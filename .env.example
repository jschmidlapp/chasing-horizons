# Copy to .env (gitignored) and fill in. See docs/media.md and docs/deployment.md.

# Cloudflare R2 (S3-compatible API token with Object Read & Write on the bucket)
R2_ACCOUNT_ID=
R2_API_TOKEN=          # optional: token value (cfut_...), for Cloudflare REST API calls
R2_ACCESS_KEY_ID=      # 32-char Access Key ID (NOT the cfut_ token value)
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chasing-horizons-media

# Public URL that serves the bucket's `w/` prefix, e.g. https://pub-xxxx.r2.dev/w
# Leave empty for local dev (images served from .media/variants by `npm run dev`).
PUBLIC_MEDIA_BASE_URL=

# Optional deploy overrides (defaults in site.config.mjs)
# SITE_URL=https://jschmidlapp.github.io
# BASE_PATH=/chasing-horizons
