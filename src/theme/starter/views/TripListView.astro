---
// Generic list of trips (used for activity pages; reusable for tags, years, search results).
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TripCard from '../components/TripCard.astro';
import type { TripListViewProps } from '../../types';

type Props = TripListViewProps;
const { title, subtitle, image, trips, regionTitles } = Astro.props;
---

<BaseLayout title={title} description={subtitle} image={image}>
  <Hero image={image} title={title} subtitle={subtitle} />
  <section class="section wrap">
    <div class="card-grid">
      {trips.map((t) => <TripCard trip={t} eyebrow={regionTitles[t.data.region.id]} />)}
    </div>
  </section>
</BaseLayout>
