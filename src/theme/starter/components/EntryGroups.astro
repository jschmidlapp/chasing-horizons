---
// A titled section of entry cards, optionally split into area sub-groups (e.g. "Fort Collins").
import EntryCard from './EntryCard.astro';
import type { Entry } from '@lib/content';
import type { EntryGroup, RegionTitles } from '../../types';

interface Props {
  title: string;
  groups: EntryGroup<Entry>[];
  /** Label cards with their region when it differs from this one. */
  regionId?: string;
  regionTitles?: RegionTitles;
}
const { title, groups, regionId, regionTitles = {} } = Astro.props;
const eyebrow = (e: Entry) => (regionId && e.data.region.id !== regionId ? regionTitles[e.data.region.id] : undefined);
const showHeadings = groups.length > 1 || groups.some((g) => g.heading);
---

{groups.length > 0 && (
  <section class="section">
    <h2 class="section-title">{title}</h2>
    {groups.map((g) => (
      <div class="group">
        {showHeadings && <h3 class="group-title">{g.heading ?? 'Other'}</h3>}
        <div class="card-grid">{g.entries.map((e) => <EntryCard entry={e} eyebrow={eyebrow(e)} />)}</div>
      </div>
    ))}
  </section>
)}

<style>
  .group + .group { margin-top: 32px; }
  .group-title { font-size: 1.2rem; margin: 0 0 14px; color: var(--muted); }
</style>
