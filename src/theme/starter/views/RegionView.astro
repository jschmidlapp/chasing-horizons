---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RegionCard from '../components/RegionCard.astro';
import EntryGroups from '../components/EntryGroups.astro';
import { regionUrl, url } from '@lib/content';
import type { RegionViewProps } from '../../types';

type Props = RegionViewProps;
const { region, ancestors, subRegions, tripGroups, spotGroups, description, regionTitles } = Astro.props;
const { title, banner, cover } = region.data;
const crumbs = [{ href: url('/places/'), label: 'Regions' }, ...ancestors.map((r) => ({ href: regionUrl(r), label: r.data.title }))];
---

<BaseLayout title={title} description={description} image={cover ?? banner}>
  <Hero image={banner ?? cover} title={title}>
    <Breadcrumbs slot="eyebrow" items={crumbs} />
  </Hero>
  <div class="wrap">
    <div class="intro prose"><slot /></div>

    {subRegions.length > 0 && (
      <section class="section">
        <h2 class="section-title">Areas</h2>
        <div class="card-grid">{subRegions.map((r) => <RegionCard {...r} />)}</div>
      </section>
    )}

    <EntryGroups title="Trips" groups={tripGroups} regionId={region.id} regionTitles={regionTitles} />
    <EntryGroups title={subRegions.length ? 'Other places' : 'Places'} groups={spotGroups} regionId={region.id} regionTitles={regionTitles} />
  </div>
</BaseLayout>

<style>
  .intro:not(:empty) { padding-top: 40px; }
</style>
