---
import { render } from 'astro:content';
import RegionView from '@theme/views/RegionView.astro';
import {
  childRegions, excerpt, getRegions, getSpots, getTrips, groupByArea, regionAncestors, regionTitles, withCounts, type Region,
} from '@lib/content';

export async function getStaticPaths() {
  const regions = await getRegions();
  return regions.map((region) => ({ params: { region: region.id }, props: { region } }));
}

const { region } = Astro.props as { region: Region };
const [regions, trips, spots] = await Promise.all([getRegions(), getTrips(), getSpots()]);
const own = <T extends { data: { region: { id: string } } }>(list: T[]) => list.filter((e) => e.data.region.id === region.id);

const { Content } = await render(region);
---

<RegionView
  region={region}
  ancestors={regionAncestors(regions, region)}
  subRegions={withCounts(childRegions(regions, region), regions, trips, spots)}
  tripGroups={groupByArea(own(trips))}
  spotGroups={groupByArea(own(spots))}
  description={excerpt(region)}
  regionTitles={regionTitles(regions)}
>
  <Content />
</RegionView>
