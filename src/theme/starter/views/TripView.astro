---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TripMeta from '../components/TripMeta.astro';
import TripMap from '../components/TripMap.astro';
import TripCard from '../components/TripCard.astro';
import { regionUrl, url } from '@lib/content';
import type { TripViewProps } from '../../types';

type Props = TripViewProps;
const { trip, regionChain, track, related, description } = Astro.props;
const { title, banner, cover, area } = trip.data;
const crumbs = [
  { href: url('/places/'), label: 'Places' },
  ...regionChain.map((r) => ({ href: regionUrl(r), label: r.data.title })),
];
---

<BaseLayout title={title} description={description} image={cover ?? banner}>
  <Hero image={banner ?? cover} title={title} subtitle={area}>
    <Breadcrumbs slot="eyebrow" items={crumbs} />
  </Hero>

  <article class="wrap section">
    <TripMeta trip={trip} track={track} />
    {track && <TripMap track={track} />}
    <div class="prose"><slot /></div>
  </article>

  {related.length > 0 && (
    <section class="wrap section">
      <h2 class="section-title">More from {regionChain.at(-1)?.data.title}</h2>
      <div class="card-grid">{related.map((t) => <TripCard trip={t} />)}</div>
    </section>
  )}
</BaseLayout>
